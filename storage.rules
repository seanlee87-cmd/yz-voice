rules_version='2';service firebase.storage{match /b/{bucket}/o{match /avatars/{uid}/{all=**}{allow read:if true;allow write:if request.auth!=null&&request.auth.uid==uid&&request.resource.size<5*1024*1024&&request.resource.contentType.matches('image/.*');}match /room-backgrounds/{roomId}/{uid}/{all=**}{allow read:if true;allow write:if request.auth!=null&&request.auth.uid==uid&&request.resource.size<8*1024*1024&&request.resource.contentType.matches('image/.*');}}}
