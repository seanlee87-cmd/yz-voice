rules_version='2';service cloud.firestore{match /databases/{database}/documents{function s(){return request.auth!=null;}match /users/{uid}{allow read:if s();allow write:if false;}match /user_private/{uid}{allow read:if s()&&request.auth.uid==uid;allow write:if false;}match /rooms/{id}{allow read:if s();allow write:if false;}match /{doc=**}{allow read,write:if false;}}}
